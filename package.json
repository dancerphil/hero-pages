{
  "name": "hero-pages-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "ln -sf .env .dev.vars",
    "dev": "pnpm --filter @hero-pages/app dev",
    "build": "pnpm --filter @hero-pages/app run build",
    "deploy:production": "pnpm build && wrangler deploy",
    "pretypes": "ln -sf .env .dev.vars",
    "types": "wrangler types --path packages/app/worker-configuration.d.ts",
    "sync:db": "pnpm sync:d1 && pnpm sync:r2",
    "sync:r2": "node scripts/sync-r2.ts",
    "sync:d1": "wrangler d1 export hero-pages --remote -y --no-data --output=.wrangler/tmp/schema.sql && wrangler d1 export hero-pages --remote -y --no-schema --output=.wrangler/tmp/data.sql && rm -rf .wrangler/state/v3/d1 && wrangler d1 execute hero-pages --local --file=.wrangler/tmp/schema.sql && wrangler d1 execute hero-pages --local --file=.wrangler/tmp/data.sql",
    "lint": "eslint .",
    "lint-type": "pnpm -r --if-present run lint-type",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@hero-u/eslint-config": "^1.5.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@11.8.0"
}
