{
  "name": "hero-pages-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hero-pages/achievement dev",
    "build": "pnpm --filter @hero-pages/achievement run build",
    "deploy": "pnpm --filter @hero-pages/achievement run deploy",
    "lint": "eslint .",
    "lint-type": "pnpm -r --if-present run lint-type",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@hero-u/eslint-config": "^1.5.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.8.0"
}
