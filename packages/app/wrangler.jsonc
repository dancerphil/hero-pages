{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hero-pages",
	"main": "src/server/index.ts",
	"compatibility_date": "2026-10-15",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hero-pages",
			"database_id": "4ccbe196-479e-4631-b697-4e49634f44e3",
			"migrations_dir": "../../migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "hero-pages-images"
		}
	],
	"vars": {
		"EMAIL_FROM": "dancerphil <noreply@dancerphil.com>"
	},
	"routes": [{ "pattern": "dancerphil.com", "custom_domain": true }]
}
